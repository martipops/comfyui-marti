{
  "name": "comfyui-marti",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Frontend for the comfyui-marti node pack.",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
